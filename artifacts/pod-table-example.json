              }
            ],
            "rows": [
              {
                "3175200e-732d-458a-8194-65ddbb3eb016": "•  Please check the following items when receiving cargo.\n•  Prepare receipt / handover documents such as a Delivery Note or Cargo In-Out Receipt.\n•  Confirm the signatures and company stamps of both the delivering party and the receiving party.\n•  Ensure that the document includes the following information:\n    ○  Date and time     ○  Cargo quantity     ○  Cargo details\n    ○  Shipment reference numbers such as Invoice / PI / PO / SO\n•  If there are any discrepancies such as shortage, damage, or misdelivery, clearly note them at the time of receipt."
              }
            ],
            "total": false,
            "repeatable": true,
